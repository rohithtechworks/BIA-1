# ==========================================
# HOME SPOKEN CENTRE - ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security & Session Secrets
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS
SESSION_COOKIE_NAME=hsc_session

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Video Storage (Cloudflare R2 or S3 Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_CUSTOM_DOMAIN=https://your-custom-r2-domain.com
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Initial Admin Setup (Run script or seed to generate)
INITIAL_ADMIN_PHONE=+919876543210
INITIAL_ADMIN_PASSWORD=change_this_secure_password_123
